generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}


model Notification {

  id String @id @default(uuid())


  userId String


  type NotificationType


  title String

  message String


  isRead Boolean @default(false)


  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt


  @@index([userId])
}

enum NotificationType {
  TASK_ASSIGNED
  TASK_COMPLETED
  COMMENT_CREATED
  COMMENT_MENTIONED
  PROJECT_INVITED
  SYSTEM
}